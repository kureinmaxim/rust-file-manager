# Copy to .env and fill in. NEVER commit the real .env file.

# Address the app listens on (keep it on localhost behind nginx)
BIND_ADDR=127.0.0.1:8080

# Where uploaded files are stored
UPLOAD_DIR=uploads

# User accounts (bcrypt hashes) and pending invites; include it in backups
USERS_FILE=users.json

# Per-file upload limit, in megabytes (match nginx client_max_body_size)
MAX_FILE_SIZE_MB=200

# Login credentials. Generate the hash with:
#   echo 'your-password' | rust-file-manager hash-password
# IMPORTANT: keep the single quotes around the hash — without them the
# $-sequences inside the hash are expanded as variables and login breaks.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# Session cookie signing key: base64 of >= 64 random bytes. Generate with:
#   openssl rand -base64 64 | tr -d '\n'
# If unset, a random key is used and sessions reset on every restart.
SESSION_SECRET=

# Set to true when serving over HTTPS (recommended in production)
COOKIE_SECURE=false

# Log level (tracing syntax), e.g. info, debug, rust_file_manager=debug
RUST_LOG=info

# --- Telegram Mini App «Файлы» (TELEGRAM_MINIAPP.md) -------------------------
# Off by default. When enabled the server also serves /tg/, /api/v1/* and /d/*.
MINIAPP_ENABLED=false
# Number before ':' in the bot token. The token itself is NOT needed here:
# Telegram's initData is verified with Telegram's public Ed25519 key.
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
# Public HTTPS origin of this server; used in invite links handed to the bot
PUBLIC_BASE_URL=https://files.example.com
# true only for a bot in Telegram's test environment
TG_TEST_ENV=false
# How old Telegram's initData may be when opening a session (seconds)
TG_INIT_DATA_MAX_AGE_SECS=3600
# Chunked uploads from the Mini App: per-file limit and chunk size (MB).
# Keep the chunk well below Cloudflare's 100 MB request limit.
MAX_CHUNKED_FILE_SIZE_MB=4096
UPLOAD_CHUNK_SIZE_MB=8

# --- Internal API for the TelegramOnly bot ----------------------------------
# Separate listener, never proxied by nginx. Leave empty to disable.
INTERNAL_BIND_ADDR=
# At least 32 characters; the same value goes to FILES_SERVICE_TOKEN of the bot.
# Generate with:  openssl rand -base64 48 | tr -d '\n'
INTERNAL_API_TOKEN=
